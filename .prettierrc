{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "@ianvs/prettier-plugin-sort-imports"],
	"importOrder": [
		"<TYPES>",
		"^(svelte/(.*)$)|^(svelte$)",
		"<THIRD_PARTY_MODULES>",
		"",
		"<TYPES>^[.|..|~]",
		"^~/",
		"^[../]",
		"^[./]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
	"importOrderTypeScriptVersion": "5.0.0",
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
